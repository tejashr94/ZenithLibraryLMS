# Zenith Library Management System — Frontend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local` to version control.
# Only VITE_* variables are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# The deployed Google Apps Script Web App URL.
# Get this from: Apps Script → Deploy → Manage deployments → Web App URL
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Override in .env.local if needed
# VITE_APP_NAME=Zenith Library Management System
